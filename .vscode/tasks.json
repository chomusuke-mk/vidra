{
  "$schema": "vscode://schemas/tasks",
  "version": "2.0.0",
  "inputs": [
    {
      "id": "targetPlatform",
      "type": "pickString",
      "description": "Selecciona la plataforma para compilar Serious Python",
      "options": [
        "Android",
        "Windows",
        "Linux",
        "iOS",
        "Darwin",
      ],
      "default": "Android"
    }
  ],
  "tasks": [
    {
      "label": "Flutter: Clean Android (gradlew clean)",
      "type": "shell",
      "command": "./gradlew",
      "args": [
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}/android",
        "env": {
          "SERIOUS_PYTHON_SITE_PACKAGES": "${workspaceFolder}/.serious_python/site-packages",
          "SERIOUS_PYTHON_APP": "${workspaceFolder}/.serious_python/app",
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Serious Python: Package App",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Prepare: Create site-packages directory",
        "Serious Python: Package App (Internal)",
        "Serious Python: Package App[ADD CURL-CFFI]"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Serious Python: Package App (Internal)",
      "type": "process",
      "command": "dart",
      "args": [
        "run",
        "serious_python:main",
        "package",
        "app/src",
        "-r",
        "-r",
        "-r",
        "app/requirements/base.txt",
        "-r",
        "-r",
        "-r",
        "app/requirements/${input:targetPlatform}.txt",
        "-p",
        "${input:targetPlatform}",
        "--verbose",
        "--compile-packages",
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SERIOUS_PYTHON_SITE_PACKAGES": "${workspaceFolder}/.serious_python/site-packages",
          "SERIOUS_PYTHON_APP": "${workspaceFolder}/.serious_python/app",
        }
      },
      "hide": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Serious Python: Package App[ADD CURL-CFFI]",
      "type": "shell",
      "command": "if [ \"${input:targetPlatform}\" = \"Android\" ]; then mkdir -p $SERIOUS_PYTHON_TMP && dart run serious_python:main package app/src -r -r -r $BASE_REQUIREMENTS -r -r -r $ANDROID_REQUIREMENTS -r curl-cffi -p Android --verbose --compile-packages --arch arm64-v8a && rm -rf $ARM64_V8A_TO && mv $ARM64_V8A_FROM $ARM64_V8A_TO && rm -rf $SERIOUS_PYTHON_TMP; fi",
      "windows": {
        "command": "cmd",
        "args": [
          "/c",
          "if \"${input:targetPlatform}\" == \"Android\" (mkdir %SERIOUS_PYTHON_TMP% && dart run serious_python:main package app/src -r -r -r %BASE_REQUIREMENTS% -r -r -r %ANDROID_REQUIREMENTS% -r curl-cffi -p Android --verbose --compile-packages --arch arm64-v8a && rmdir /s /q %ARM64_V8A_TO% && move %ARM64_V8A_FROM% %ARM64_V8A_TO% && rmdir /s /q %SERIOUS_PYTHON_TMP%)"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SERIOUS_PYTHON_SITE_PACKAGES": "${workspaceFolder}/.serious_python_tmp/site-packages",
          "SERIOUS_PYTHON_APP": "${workspaceFolder}/.serious_python_tmp/app",
          "SERIOUS_PYTHON_TMP": ".serious_python_tmp",
          "BASE_REQUIREMENTS": "app/requirements/base.txt",
          "ANDROID_REQUIREMENTS": "app/requirements/Android.txt",
          "ARM64_V8A_FROM": ".serious_python_tmp/site-packages/arm64-v8a",
          "ARM64_V8A_TO": ".serious_python/site-packages/arm64-v8a"
        }
      },
      "hide": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Prepare: Create site-packages directory",
      "type": "process",
      "command": "bash",
      "windows": {
        "command": "cmd",
        "args": [
          "/c",
          "if not exist ${workspaceFolder}\\.serious_python\\site-packages mkdir ${workspaceFolder}\\.serious_python\\site-packages"
        ]
      },
      "args": [
        "-c",
        "mkdir -p \"${workspaceFolder}/.serious_python/site-packages\""
      ],
      "problemMatcher": [],
      "hide": true,
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "clear": false
      },
    },
    {
      "label": "Build Android APK (Flutter)",
      "type": "process",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--release"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SERIOUS_PYTHON_SITE_PACKAGES": "${workspaceFolder}/.serious_python/site-packages",
          "SERIOUS_PYTHON_APP": "${workspaceFolder}/.serious_python/app",
        }
      },
      "dependsOn": [
        "Prepare: Create site-packages directory"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}